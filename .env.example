# Copy to .env and load from the repository root using set -a; source .env; set +a.
PARALLELWORLD_ROOT="${PARALLELWORLD_ROOT:-$PWD}"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
GPT_IMAGE_API_KEY="${OPENAI_API_KEY}"
GPT_IMAGE_BASE_URL="${OPENAI_BASE_URL}"
# Configure an endpoint exposing the model identifiers used by the experiment.
# OPENAI_USER_AGENT is optional for endpoints requiring a custom header.

# ESI-Bench: activate the separately installed OmniGibson environment before evaluation.
JSON_ROOT="${PARALLELWORLD_ROOT}/data/understanding/json_clean"
MODEL="gpt-5.4"
VERIFIER_MODEL="gpt-5.5"
MAX_STEPS=15
MIN_STEPS=0
THRESHOLD=0.8
ANSWER_REVIEW=1
ANSWER_EVIDENCE_MODE=top1-route
PARALLELWORLD_UNDERSTANDING_RUNTIME_ROOT="${PARALLELWORLD_ROOT}/parallelworld_understanding/.runtime"
SUITE_OUTPUT_ROOT="${PARALLELWORLD_ROOT}/parallelworld_understanding/outputs/parallelworld"
SUITE_STATE_ROOT="${SUITE_OUTPUT_ROOT}"
RESULTS_SUMMARY_PATH="${SUITE_OUTPUT_ROOT}/RESULTS_SUMMARY.md"

# LIBERO-Pro: install the environment and download checkpoints as documented.
PARALLELWORLD_REPO_ROOT="${PARALLELWORLD_ROOT}/parallelworld_manipulation"
PW_PYTHON="${PARALLELWORLD_ROOT}/.venv-manipulation/bin/python"
PW_CHECKPOINT_ROOT="${PARALLELWORLD_ROOT}/checkpoints"
PI05_CHECKPOINT_PATH="${PW_CHECKPOINT_ROOT}/RLinf-Pi05-LIBERO-130-fullshot-SFT"
SAM3_CHECKPOINT_PATH="${PW_CHECKPOINT_ROOT}/sam3/sam3.pt"
LIBERO_TYPE=pro
MUJOCO_GL=egl
PARALLELWORLD_CODEX_AUTH=api
HF_HUB_OFFLINE=1
PW_RESULTS_ROOT="${PARALLELWORLD_ROOT}/eval_runs/libero_pro"
PW_GPUS="0 1 2 3 4 5 6 7"
# Set role models explicitly per benchmark setting; see the LIBERO-Pro guide.
